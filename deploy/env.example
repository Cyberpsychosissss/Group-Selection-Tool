# 复制到 ~/.config/group-selection-tool/env 并 chmod 600
GST_DEV=0
GST_ACCESS_CODE=<课程群里公布的口令>
GST_WHOAMI_URL=http://127.0.0.1:8082/api/whoami
GST_ADMIN_USER=admin
GST_TRUST_PROXY=1
GST_PROXY_HOPS=2
GST_DB=/home/zihao/services/group-selection-tool/data/app.db
GST_COUNTS_TOKEN=<openssl rand -hex 24 生成，给爬虫用>
